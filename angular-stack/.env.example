# Angular Stack Environment Variables (read by the API server in server/)

# Database (schema lives in ../schema.sql)
DATABASE_URL=postgresql://social_user:social_pass_2026@localhost:5432/social_audit

# Signs the session JWT cookie
JWT_SECRET=your-jwt-secret-change-in-production

# Set to "false" to allow the session cookie over plain HTTP in production
COOKIE_SECURE=true

# Defaults: 4300 in development (ng serve proxies /api to it), 4200 once dist/ exists
# PORT=4200
