---
/**
 * Home page - Feed view
 * SSR with Svelte islands for interactivity
 */
import Layout from '@/layouts/Layout.astro';
import Feed from '@/components/Feed.svelte';
import Compose from '@/components/Compose.svelte';
import Sidebar from '@/components/Sidebar.svelte';
import { sql } from '@/lib/db';

// Server-side data fetching
// This runs at build time (SSG) or request time (SSR)
const currentUser = null; // TODO: Get from session

// Fetch initial feed data
const initialPosts = []; // TODO: Fetch from database

---

<Layout title="Home / Social Audit">
  <div class="min-h-screen">
    <!-- Header -->
    <header class="bg-white border-b sticky top-0 z-10">
      <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
        <h1 class="text-2xl font-bold text-blue-600">Social Audit</h1>
        <div class="flex gap-4 items-center">
          {currentUser ? (
            <span class="font-semibold">@{currentUser.username}</span>
          ) : (
            <a href="/login" class="text-blue-600 hover:underline">Login</a>
          )}
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-6 grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Sidebar (static Astro component) -->
      <aside class="hidden md:block">
        <Sidebar />
      </aside>

      <!-- Feed (Svelte island for interactivity) -->
      <div class="md:col-span-2 space-y-4">
        <!-- Compose (Svelte island) -->
        <Compose client:load />

        <!-- Feed (Svelte island with initial data from SSR) -->
        <Feed client:load initialPosts={initialPosts} />
      </div>
    </main>
  </div>
</Layout>
