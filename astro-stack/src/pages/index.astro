---
/**
 * Home page: the first feed page is rendered on the server,
 * then the Svelte island takes over for infinite scroll and mutations.
 */
import Layout from '@/layouts/Layout.astro';
import FeedApp from '@/components/FeedApp.svelte';
import Sidebar from '@/components/Sidebar.astro';
import { getFeed } from '@/lib/posts';

const user = Astro.locals.user;
const initialPage = await getFeed(user?.id ?? null, null);
---

<Layout title="Home / Social Audit">
  <main class="mx-auto grid max-w-7xl grid-cols-1 gap-6 px-4 py-6 md:grid-cols-3">
    <aside class="hidden md:block">
      <Sidebar />
    </aside>

    <div class="md:col-span-2">
      <FeedApp client:load initialPage={initialPage} loggedIn={Boolean(user)} />
    </div>
  </main>
</Layout>
