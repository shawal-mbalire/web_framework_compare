---
/**
 * Main layout: SSR shell shared by every page
 */
import { actions } from 'astro:actions';
import '@/styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Social Audit - Astro Stack' } = Astro.props;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Twitter/X clone built with Astro" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <header class="sticky top-0 z-10 border-b bg-white">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3">
        <a href="/" class="text-2xl font-bold text-blue-600">Social Audit</a>
        <div class="flex items-center gap-4">
          {
            user ? (
              <>
                <span class="font-semibold">@{user.username}</span>
                <form method="POST" action={'/login' + actions.logout}>
                  <button type="submit" class="text-blue-600 hover:underline">
                    Log out
                  </button>
                </form>
              </>
            ) : (
              <a href="/login" class="text-blue-600 hover:underline">
                Log in
              </a>
            )
          }
        </div>
      </div>
    </header>
    <slot />
  </body>
</html>
