---
/**
 * Main layout component
 * SSR wrapper for all pages
 */
import '@/styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Social Audit - Astro Stack' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Twitter/X clone built with Astro" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-gray-50 min-h-screen">
    <slot />
  </body>
</html>
