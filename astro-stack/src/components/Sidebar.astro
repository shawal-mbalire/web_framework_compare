---
/**
 * Sidebar Component (static: ships zero JS)
 */
const links = [
  { href: '/', label: 'Home' },
  { href: '/login', label: 'Account' },
];
const current = Astro.url.pathname;
---

<nav class="space-y-1 rounded-lg border bg-white p-4">
  {
    links.map(({ href, label }) => (
      <a
        href={href}
        class:list={[
          'block rounded px-4 py-2 hover:bg-gray-100',
          { 'bg-blue-50 font-semibold text-blue-600': current === href },
        ]}
      >
        {label}
      </a>
    ))
  }
</nav>
