# Astro Stack Environment Variables

# Database (schema lives in ../schema.sql)
DATABASE_URL=postgresql://social_user:social_pass_2026@localhost:5432/social_audit

# Signs the session JWT cookie
JWT_SECRET=your-jwt-secret-change-in-production

# Set to "false" to allow the session cookie over plain HTTP in production builds
COOKIE_SECURE=true

# Server (production build: node dist/server/entry.mjs)
HOST=0.0.0.0
PORT=4321
