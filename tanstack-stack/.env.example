# TanStack Start Environment Variables

# Database (schema lives in ../schema.sql)
DATABASE_URL=postgresql://social_user:social_pass_2026@localhost:5432/social_audit

# Encrypts the session cookie (must be at least 32 characters)
SESSION_SECRET=your-session-secret-change-in-production-32chars

# Set to "false" to allow the session cookie over plain HTTP in production builds
COOKIE_SECURE=true

PORT=3000
